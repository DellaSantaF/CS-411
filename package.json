{
  "name": "magnus-learning-activity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "test": "node --test tests/*.test.ts",
    "hosting:check": "node scripts/check-hosting-bundle.mjs",
    "ai:check": "node --env-file-if-exists=.env scripts/check-ai.mjs",
    "keys": "node scripts/create-keys.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.11",
    "openai": "^7.52.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@netlify/zip-it-and-ship-it": "^16.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.0",
    "vite": "^8.3.6"
  }
}
