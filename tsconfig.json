{
  "compilerOptions": {
    "rootDir": ".", "outDir": "dist", "target": "ES2022", "module": "ESNext",
    "moduleResolution": "bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"], "jsx": "react-jsx", "strict": true,
    "verbatimModuleSyntax": true, "erasableSyntaxOnly": true, "allowImportingTsExtensions": true,
    "allowJs": true, "checkJs": false, "noEmit": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src", "server", "tests", "vite.config.ts"]
}
