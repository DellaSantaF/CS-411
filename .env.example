# Copy to .env and insert your key locally. Never put the key in browser code or chat.
# Live requests are billable. Use development for free simulated responses.
AI_MODE=live
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Both roles always use reasoning.effort=low. Blank role models use OPENAI_MODEL.
OPENAI_EVALUATOR_MODEL=
OPENAI_TUTOR_MODEL=
OPENAI_MAX_CALLS_PER_SESSION=40
PORT=3001
